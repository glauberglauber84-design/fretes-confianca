---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, whatsappLink } from '../config/siteConfig';
---
<BaseLayout title={`Obrigado | ${siteConfig.name}`} description="Recebemos o seu pedido de orçamento." noindex>
  <div class="mx-auto max-w-3xl px-4 pt-10">
    <h1 class="text-3xl font-extrabold md:text-4xl">Recebemos o seu pedido</h1>
    <p class="mt-3 text-lg">Obrigado! Para agilizar, continue a conversa pelo WhatsApp.</p>
    <a href={whatsappLink('Olá! Acabei de enviar um pedido de orçamento pelo site.')} class="btn btn-wa mt-5">WhatsApp {siteConfig.phone}</a>
  </div>
</BaseLayout>
