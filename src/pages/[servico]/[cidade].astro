---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Hero from '../../components/Hero.astro';
import ServicosGrid from '../../components/ServicosGrid.astro';
import Sobre from '../../components/Sobre.astro';
import ComoEncontrar from '../../components/ComoEncontrar.astro';
import FAQ from '../../components/FAQ.astro';
import ContatoForm from '../../components/ContatoForm.astro';
import CTA from '../../components/CTA.astro';
import { siteConfig } from '../../config/siteConfig';
import { getLocais, getCidades } from '../../lib/locais';
import { loadPageContent } from '../../lib/pageContent';
import { service } from '../../lib/schema';

export function getStaticPaths() {
  return getLocais().map((l) => ({
    params: { servico: l.servico, cidade: l.cidade },
    props: { loc: l },
  }));
}
const { loc } = Astro.props;
const content = loadPageContent(loc.servico, loc.cidade, loc.servicoLabel, loc.cidadeLabel);
const cityCfg = siteConfig.cities.find((c) => c.slug === loc.cidade);
const outras = getCidades().filter((c) => c.slug !== loc.cidade);
const path = `/${loc.servico}/${loc.cidade}/`;
---
<BaseLayout
  title={content.title}
  description={content.description}
  jsonld={[service(Astro.site!.href, { name: loc.servicoLabel, path, areaServed: [cityCfg?.name ?? loc.cidadeLabel], description: content.description })]}
>
  <Breadcrumb items={[
    { name: loc.servicoLabel, path: `/servicos/${loc.servico}/` },
    { name: loc.cidadeLabel, path },
  ]} />
  <Hero h1={content.h1} subtitle={content.hero_subtitle} waText={`Olá! Gostaria de orçamento de ${loc.servicoLabel} em ${loc.cidadeLabel}.`} />
  <Sobre texto={content.sobre_texto} titulo={`${loc.servicoLabel} em ${loc.cidadeLabel}: como funciona`} />

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="mesmo-servico">
    <h2 id="mesmo-servico" class="text-2xl font-extrabold md:text-3xl">{loc.servicoLabel} em outras cidades</h2>
    <ul class="mt-4 flex flex-wrap gap-3">
      {outras.map((c) => (
        <li>
          <a href={`/${loc.servico}/${c.slug}/`} class="inline-flex min-h-[48px] items-center rounded-lg border border-brand-200 px-4 font-semibold text-brand-900 hover:border-brand-900 hover:bg-brand-50">{c.label}</a>
        </li>
      ))}
      <li>
        <a href={`/servicos/${loc.servico}/`} class="inline-flex min-h-[48px] items-center rounded-lg px-4 font-semibold text-brand-900 underline">Sobre o serviço</a>
      </li>
    </ul>
  </section>

  <ServicosGrid cidade={loc.cidade} cidadeLabel={loc.cidadeLabel} excluir={loc.servico} />
  <ComoEncontrar />
  <FAQ items={content.faq} />
  <ContatoForm cidade={loc.cidade} servico={loc.servico} />
  <div class="mt-12"><CTA /></div>
</BaseLayout>
