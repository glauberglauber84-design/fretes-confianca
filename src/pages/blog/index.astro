---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostsGrid from '../../components/PostsGrid.astro';
import CTA from '../../components/CTA.astro';
import { siteConfig } from '../../config/siteConfig';
import { posts } from '../../config/posts';
import { itemList } from '../../lib/schema';

const description = 'Guias práticos para planejar sua mudança, pedir orçamento de frete e organizar entregas na Grande São Paulo.';
---
<BaseLayout
  title={`Guias de mudança e frete | ${siteConfig.name}`}
  description={description}
  jsonld={[itemList(Astro.site!.href, posts.map((p) => ({ name: p.title, path: `/blog/${p.slug}/` })))]}
>
  <Breadcrumb items={[{ name: 'Guias', path: '/blog/' }]} />
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="text-3xl font-extrabold md:text-4xl">Guias de mudança e frete</h1>
    <p class="mt-3 max-w-prose text-lg">{description}</p>
  </div>
  <PostsGrid />
  <div class="mt-12"><CTA /></div>
</BaseLayout>
