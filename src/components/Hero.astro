---
import { Image } from 'astro:assets';
import hero from '../assets/hero-caminhao.jpg';
import { siteConfig, whatsappLink } from '../config/siteConfig';

interface Props {
  h1: string;
  subtitle: string;
  waText?: string;
}
const { h1, subtitle, waText = 'Olá! Gostaria de pedir um orçamento.' } = Astro.props;
---
<section class="bg-brand-50">
  <div class="mx-auto grid max-w-6xl items-center gap-6 px-4 py-8 md:grid-cols-2 md:gap-10 md:py-14">
    <div>
      <h1 class="font-extrabold">{h1}</h1>
      <p class="mt-3 max-w-xl text-lg text-ink">{subtitle}</p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappLink(waText)} class="btn btn-wa">WhatsApp {siteConfig.phone}</a>
        <a href="#contato" class="btn btn-outline">Pedir orçamento</a>
      </div>
    </div>
    <Image
      src={hero}
      alt="Caminhão baú branco estacionado, usado em fretes e mudanças"
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 560px, 100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-auto w-full rounded-xl object-cover"
    />
  </div>
</section>
