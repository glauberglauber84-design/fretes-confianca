---
import { siteConfig } from '../config/siteConfig';
interface Props {
  cidade?: string; // slug: linka para /[servico]/[cidade]/
  cidadeLabel?: string;
  excluir?: string; // slug de servico a omitir
  titulo?: string;
}
const { cidade, cidadeLabel, excluir, titulo } = Astro.props;
const lista = siteConfig.services.filter((s) => s.slug !== excluir);
const heading = titulo ?? (cidadeLabel ? `Outros serviços em ${cidadeLabel}` : 'Nossos serviços');
---
<section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="servicos-titulo">
  <h2 id="servicos-titulo" class="font-extrabold">{heading}</h2>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {lista.map((s) => (
      <li>
        <a
          href={cidade ? `/${s.slug}/${cidade}/` : `/servicos/${s.slug}/`}
          class="flex h-full flex-col rounded-xl border border-brand-200 bg-white p-4 hover:border-brand-900 hover:bg-brand-50"
        >
          <h3 class="font-bold">{s.label}</h3>
          <p class="mt-1 text-ink">{s.short}</p>
          <span class="mt-3 font-semibold text-brand-900 underline">Ver detalhes</span>
        </a>
      </li>
    ))}
  </ul>
</section>
