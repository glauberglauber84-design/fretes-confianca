---
import { siteConfig } from '../config/siteConfig';
import JsonLd from './JsonLd.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
}
const { title, description, ogImage = siteConfig.ogImage, noindex = false, jsonld = [] } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, site).href;
const image = new URL(ogImage, site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Caminhão baú branco para fretes e mudanças" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{jsonld.length > 0 && <JsonLd data={jsonld} />}
