---
import { posts } from '../config/posts';
---
<section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="posts-titulo">
  <h2 id="posts-titulo" class="text-2xl font-extrabold md:text-3xl">Guias para sua mudança e seu frete</h2>
  <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.slug}/`} class="flex h-full flex-col rounded-xl border border-brand-200 bg-white p-4 hover:border-brand-900 hover:bg-brand-50">
          <h3 class="text-lg font-bold">{p.title}</h3>
          <p class="mt-1 text-ink">{p.summary}</p>
          <span class="mt-3 font-semibold text-brand-900 underline">Ler guia</span>
        </a>
      </li>
    ))}
  </ul>
</section>
