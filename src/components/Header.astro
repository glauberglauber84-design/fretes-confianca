---
import { siteConfig, whatsappLink } from '../config/siteConfig';
const wa = whatsappLink('Olá! Gostaria de pedir um orçamento.');
const link = 'inline-flex min-h-[44px] items-center px-3 font-semibold text-brand-900 hover:underline';
---
<header class="border-b border-brand-100 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2">
    <a href="/" class="inline-flex min-h-[44px] items-center font-display text-xl font-extrabold text-brand-900" aria-label={`${siteConfig.name} - página inicial`}>
      {siteConfig.name}
    </a>

    <nav class="hidden items-center md:flex" aria-label="Principal">
      {siteConfig.nav.map((n) => <a href={n.href} class={link}>{n.label}</a>)}
      <a href={wa} class="btn btn-wa ml-2 !min-h-[44px] !py-2">WhatsApp {siteConfig.phone}</a>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center gap-2 rounded border-2 border-brand-900 px-3 font-bold text-brand-900">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        Menu
      </summary>
      <nav class="absolute right-0 z-30 mt-2 w-64 rounded-lg border border-brand-100 bg-white p-2 shadow-lg" aria-label="Principal (celular)">
        {siteConfig.nav.map((n) => <a href={n.href} class={`${link} w-full`}>{n.label}</a>)}
        <a href={wa} class="btn btn-wa mt-2 w-full">WhatsApp {siteConfig.phone}</a>
      </nav>
    </details>
  </div>
</header>
