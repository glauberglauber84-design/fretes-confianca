---
import { siteConfig } from '../config/siteConfig';
import JsonLd from './JsonLd.astro';
import { localBusiness } from '../lib/schema';
---
<section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="onde-titulo">
  <h2 id="onde-titulo" class="font-extrabold">Onde atendemos</h2>
  <div class="mt-6 grid gap-8 md:grid-cols-2">
    <div>
      <p class="max-w-prose">
        Atendemos a Zona Leste de São Paulo e cidades da Grande São Paulo. Não temos loja aberta ao público: o atendimento é feito pelo WhatsApp e o serviço vai até você.
      </p>
      <h3 class="mt-5 font-bold">Cidades atendidas</h3>
      <ul class="mt-2 list-disc pl-5">
        {siteConfig.areaServed.map((c) => <li>{c}</li>)}
      </ul>
      <address class="mt-5 not-italic">
        <p class="font-bold text-brand-900">{siteConfig.name}</p>
        <p>{siteConfig.region}</p>
        <p>
          <a class="inline-flex min-h-[44px] items-center font-semibold text-brand-900 underline" href={siteConfig.phoneHref}>{siteConfig.phone}</a>
        </p>
      </address>
    </div>
    <div
      id="mapa"
      class="flex h-72 w-full items-center justify-center rounded-xl border border-brand-200 bg-brand-50 md:h-full md:min-h-[320px]"
      data-src={siteConfig.mapEmbedUrl}
      data-title="Mapa da região de atendimento: Zona Leste, São Paulo - SP"
    >
      <button
        type="button"
        id="mapa-btn"
        class="inline-flex min-h-[44px] items-center rounded-lg bg-brand-900 px-5 py-3 font-bold text-white hover:bg-brand-800 focus-light"
      >
        Ver mapa da região
      </button>
    </div>
  </div>
  <script is:inline>
    (function () {
      var box = document.getElementById('mapa');
      var btn = document.getElementById('mapa-btn');
      if (!box || !btn) return;
      btn.addEventListener('click', function () {
        var f = document.createElement('iframe');
        f.src = box.dataset.src;
        f.title = box.dataset.title;
        f.className = 'h-full w-full rounded-xl';
        f.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
        box.replaceChildren(f);
      });
    })();
  </script>
  <JsonLd data={localBusiness(Astro.site!.href)} />
</section>
