---
import { siteConfig } from '../config/siteConfig';
const a = 'inline-flex min-h-[44px] items-center underline-offset-2 hover:underline';
---
<footer class="on-dark mt-16 bg-brand-950 text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
    <div>
      <p class="font-display text-xl font-extrabold">{siteConfig.name}</p>
      <p class="mt-3 max-w-xs text-brand-100">
        Fretes e mudanças com {siteConfig.foundingNote} de atendimento na Grande São Paulo.
      </p>
      <p class="mt-3 text-brand-100">{siteConfig.region}</p>
    </div>
    <div>
      <h2 class="font-display font-bold !text-white">Serviços</h2>
      <ul class="mt-2">
        {siteConfig.services.map((s) => <li><a class={a} href={`/servicos/${s.slug}/`}>{s.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-display font-bold !text-white">Contato</h2>
      <address class="mt-2 not-italic">
        <p class="font-semibold">{siteConfig.name}</p>
        <p>{siteConfig.region}</p>
        <p>
          <a class={a} href={siteConfig.phoneHref}>{siteConfig.phone}</a>
        </p>
        <p>
          <a class="btn btn-wa mt-1 !min-h-[44px] !py-2" href={siteConfig.whatsappUrl}>Chamar no WhatsApp</a>
        </p>
      </address>
      <h3 class="mt-4 font-display font-bold !text-white">Cidades atendidas</h3>
      <p class="mt-1 text-brand-100">{siteConfig.areaServed.join(' · ')}</p>
    </div>
  </div>
  <div class="border-t border-brand-800">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 px-4 py-2 text-sm">
      <a class={a} href="/sobre/">Sobre</a>
      <a class={a} href="/contato/">Contato</a>
      <a class={a} href="/blog/">Conteúdo</a>
      <a class={a} href="/politica-de-privacidade/">Política de Privacidade</a>
      <span class="ml-auto text-brand-100">© {new Date().getFullYear()} {siteConfig.name}</span>
    </div>
  </div>
</footer>
